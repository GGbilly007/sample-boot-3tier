        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
        </dependency>

        <!--
            TODO (step 6): once the Jackson annotations have moved out of the
            entities and onto the DTOs, DELETE this dependency. If the module
            still compiles without it, the entities are properly free of JSON.
        -->
