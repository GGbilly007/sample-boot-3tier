<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.3.0.RELEASE</version>
        <relativePath/>
    </parent>

    <groupId>th.mfu</groupId>
    <artifactId>library-3tier</artifactId>
    <version>1.0-SNAPSHOT</version>

    <!--
        packaging=pom: this project builds no jar of its own. Its job is to tie
        the three modules together and hold the settings they share.

        ALWAYS run Maven from THIS folder. The web service needs the domain
        model, and the domain model has to be built first.
    -->
    <packaging>pom</packaging>
    <name>library-3tier</name>

    <modules>
        <module>library-domain-model</module>
        <module>library-web-service</module>
        <module>library-web-front</module>
    </modules>

    <properties>
        <java.version>11</java.version>
        <!--
            Declared so that `mvn install -DskipTests` ALSO skips starting the
            service for the integration tests. Without this, -DskipTests only
            silences the tests, the spring-boot:start goal still tries to boot
            the app, and the very first build of the day fails at step 1 -
            before @EntityScan has been added.
        -->
        <skipTests>false</skipTests>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <!--
            RESTEasy 3.x, not the 6.2.5.Final on the slide. Version 6 is built on
            jakarta.ws.rs, but Spring Boot 2.3 is still on javax.* - mixing them
            gives NoClassDefFoundError: javax/ws/rs/client/ClientBuilder.
        -->
        <resteasy.version>3.15.6.Final</resteasy.version>
        <surefire.version>3.2.5</surefire.version>
        <failsafe.version>3.2.5</failsafe.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                    MapStruct generates the mapper implementations while the code
                    compiles, so it is an annotation processor and not an
                    ordinary dependency.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${java.version}</release>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                        </annotationProcessorPaths>
                        <compilerArgs>
                            <compilerArg>-Amapstruct.defaultComponentModel=spring</compilerArg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${failsafe.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
